---
const { items, eyebrow, title } = Astro.props;
---

<section class="section">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <div class="card-grid">
      {items.map((item) => (
        <article class="card">
          <h3><a href={item.href}>{item.title}</a></h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
