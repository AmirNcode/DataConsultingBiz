---
const {
  title = "Ready to make your business data easier to use?",
  text = "Share what you want to understand better. Data Fort will review your current reporting setup and suggest a practical next step.",
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-grid">
    <div>
      <p class="eyebrow">Start with a conversation</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="button button-primary" href="/#contact">Get in touch</a>
    </div>
  </div>
</section>
