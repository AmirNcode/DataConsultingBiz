---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cta from "../../components/Cta.astro";
import { locations, site } from "../../data/site.js";

const title = "Independent Pharmacy Analytics and Business Intelligence | Data Fort";
const description =
  "Independent pharmacy analytics and pharmacy business intelligence for Toronto and GTA pharmacies, including refill retention, pharmacy dashboard reporting, front-shop sales, inventory movement, and patient behaviour.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Independent Pharmacy Analytics",
    provider: { "@type": "Organization", name: "Data Fort", url: site.url },
    areaServed: locations.map((name) => ({ "@type": "City", name })),
    serviceType: "Pharmacy business intelligence",
    description,
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/industries/independent-pharmacies/" structuredData={structuredData}>
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href="/">Home</a> / Industries</p>
      <p class="eyebrow">Independent pharmacy analytics</p>
      <h1>Pharmacy business intelligence for independent pharmacies in Toronto and the GTA</h1>
      <p>
        Data Fort helps independent pharmacies use pharmacy dashboard reporting to understand refill retention, active patients, front-shop sales, inventory movement, payer or category trends, and monthly performance. The goal is practical independent pharmacy analytics that supports ownership, managers, and staff without adding more spreadsheet work.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container three-grid">
      <article class="page-card">
        <h2>Pain points</h2>
        <ul>
          <li>Refill behaviour and patient retention are hard to see from day-to-day reports.</li>
          <li>Front-shop product performance is separate from prescription-side context.</li>
          <li>Inventory movement, slow movers, and stockout risk require manual review.</li>
          <li>Owners need a clearer monthly view of revenue, category mix, and operational pressure.</li>
        </ul>
      </article>
      <article class="page-card">
        <h2>Sample metrics</h2>
        <ul>
          <li>Refill retention and likely-to-lapse patient groups.</li>
          <li>Active patients, new patients, and returning patient patterns.</li>
          <li>Front-shop revenue by category and product movement.</li>
          <li>Inventory days on hand, slow movers, and high-value stock exposure.</li>
        </ul>
      </article>
      <article class="page-card">
        <h2>Decisions enabled</h2>
        <ul>
          <li>Which patient segments may need refill reminders or follow-up.</li>
          <li>Which front-shop categories deserve merchandising or promotion attention.</li>
          <li>Which inventory groups are tying up cash or creating stockout risk.</li>
          <li>Which monthly pharmacy business intelligence questions the team should review.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container two-grid">
      <div class="content-card">
        <p class="eyebrow">Local fit</p>
        <h2>For pharmacies across the GTA</h2>
        <p>
          Data Fort supports independent pharmacy analytics in Toronto, North York, Richmond Hill, Thornhill, Vaughan, Newmarket, Markham, Etobicoke, and Scarborough. Engagements can start with the pharmacy reports and exports already available.
        </p>
      </div>
      <div class="content-card">
        <p class="eyebrow">Reporting outcome</p>
        <h2>From pharmacy reports to a clearer operating view</h2>
        <p>
          The result is a more usable view of refill retention, patient behaviour, front-shop performance, inventory reporting, sales reporting, and monthly business insights so decisions are not buried in disconnected files.
        </p>
      </div>
    </div>
  </section>

  <Cta title="Want pharmacy dashboard reporting that is easier to act on?" />
</BaseLayout>
